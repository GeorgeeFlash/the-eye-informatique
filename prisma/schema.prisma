generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String                  @id @default(cuid())
  clerkId            String                  @unique
  email              String                  @unique
  name               String?
  phone              String?
  role               Role                    @default(CUSTOMER)
  preferredLocale    String                  @default("en")
  /// Non-null for STAFF and ADMIN; null for CENTRAL_ADMIN and CUSTOMER/AFFILIATE
  branchId           String?
  isActive           Boolean                 @default(true)
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  activityLogs       ActivityLog[]
  addresses          Address[]
  affiliateProfile   AffiliateProfile?
  blogArticles       BlogArticle[]           @relation("AuthoredArticles")
  reviewedArticles   BlogArticle[]           @relation("ReviewedArticles")
  sentBroadcasts     Broadcast[]             @relation("SentBroadcasts")
  knowledgeBaseDocs  KnowledgeBaseDocument[]
  notifications      Notification[]
  orders             Order[]
  orderStatusChanges OrderStatusHistory[]    @relation("OrderStatusChangedBy")
  productPageViews   ProductPageView[]
  productReviews     ProductReview[]
  cartItems          ServerCartItem[]
  branch             Branch?                 @relation(fields: [branchId], references: [id])
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  label     String?
  street    String
  city      String
  region    String
  country   String   @default("CM")
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders    Order[]
}

model Branch {
  id                   String                 @id @default(cuid())
  name                 String
  city                 String
  address              String
  phone                String?
  isActive             Boolean                @default(true)
  affiliates           AffiliateProfile[]
  orders               Order[]
  orderItemFulfillment OrderItem[]            @relation("OrderItemFulfillmentBranch")
  productPageViews     ProductPageView[]
  stockByBranch        ProductStockByBranch[]
  users                User[]
}

model Category {
  id            String                 @id @default(cuid())
  slug          String                 @unique
  name          String
  parentId      String?
  iconUrl       String?
  sortOrder     Int                    @default(0)
  parent        Category?              @relation("CategoryTree", fields: [parentId], references: [id])
  children      Category[]             @relation("CategoryTree")
  featureFields CategoryFeatureField[]
  products      Product[]
  variantAxes   CategoryVariantAxis[]
  skuTemplate   String?
}

model Tag {
  id           String        @id @default(cuid())
  name         String        @unique
  slug         String        @unique
  blogArticles BlogArticle[] @relation("ArticleTags")
  products     Product[]     @relation("ProductTags")
}

model Product {
  id               String                @id @default(cuid())
  slug             String                @unique
  name             String
  description      String?
  basePrice        Decimal               @db.Decimal(12, 2)
  currency         String                @default("XAF")
  categoryId       String
  brand            String?
  commissionType   CommissionType?
  commissionValue  Decimal?              @db.Decimal(12, 2)
  metaTitle        String?
  metaDescription  String?
  isActive         Boolean               @default(true)
  isFeatured       Boolean               @default(false)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  inStorePurchases InStorePurchase[]
  category         Category              @relation(fields: [categoryId], references: [id])
  featureValues    ProductFeatureValue[]
  images           ProductImage[]
  pageViews        ProductPageView[]
  reviews          ProductReview[]
  variants         ProductVariant[]
  tags             Tag[]                 @relation("ProductTags")
}

model ProductVariant {
  id            String                 @id @default(cuid())
  productId     String
  sku           String                 @unique
  color         String?
  condition     Condition              @default(NEW)
  stock         Int                    @default(0)
  price         Decimal                @db.Decimal(12, 2)
  weight        Decimal?               @db.Decimal(8, 3)
  createdAt     DateTime               @default(now())
  orderItems    OrderItem[]
  stockByBranch ProductStockByBranch[]
  product       Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems     ServerCartItem[]
  options       ProductVariantOption[]
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  alt       String?
  sortOrder Int     @default(0)
  isPrimary Boolean @default(false)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model CategoryFeatureField {
  id            String                @id @default(cuid())
  categoryId    String
  name          String
  type          FeatureFieldType      @default(TEXT)
  /// For DROPDOWN: ["Option A", "Option B", ...]
  options       Json?
  sortOrder     Int                   @default(0)
  isRequired    Boolean               @default(false)
  category      Category              @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  featureValues ProductFeatureValue[]

  @@index([categoryId])
}

model ProductFeatureValue {
  id             String               @id @default(cuid())
  productId      String
  featureFieldId String
  value          String
  featureField   CategoryFeatureField @relation(fields: [featureFieldId], references: [id], onDelete: Cascade)
  product        Product              @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, featureFieldId])
  @@index([featureFieldId])
}

model Order {
  id                    String               @id @default(cuid())
  orderNumber           String               @unique
  userId                String
  status                OrderStatus          @default(PENDING)
  subtotal              Decimal              @db.Decimal(12, 2)
  tax                   Decimal              @default(0) @db.Decimal(12, 2)
  deliveryFee           Decimal              @default(0) @db.Decimal(12, 2)
  total                 Decimal              @db.Decimal(12, 2)
  currency              String               @default("XAF")
  deliveryMethod        DeliveryMethod       @default(PICKUP)
  addressId             String?
  branchId              String?
  notes                 String?
  estimatedDeliveryDate DateTime?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  referral              AffiliateReferral?
  installments          Installment[]
  address               Address?             @relation(fields: [addressId], references: [id])
  branch                Branch?              @relation(fields: [branchId], references: [id])
  user                  User                 @relation(fields: [userId], references: [id])
  items                 OrderItem[]
  statusHistory         OrderStatusHistory[]
  payment               Payment?

  @@index([userId, createdAt(sort: Desc)])
}

model OrderItem {
  id                  String            @id @default(cuid())
  orderId             String
  variantId           String
  quantity            Int
  unitPrice           Decimal           @db.Decimal(12, 2)
  total               Decimal           @db.Decimal(12, 2)
  fulfillmentBranchId String?
  fulfillmentStatus   FulfillmentStatus @default(PENDING)
  fulfillmentBranch   Branch?           @relation("OrderItemFulfillmentBranch", fields: [fulfillmentBranchId], references: [id])
  order               Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant             ProductVariant    @relation(fields: [variantId], references: [id])
}

model Payment {
  id                   String          @id @default(cuid())
  orderId              String          @unique
  payunitTransactionId String?
  gateway              PaymentGateway?
  method               PaymentMethod
  amount               Decimal         @db.Decimal(12, 2)
  currency             String          @default("XAF")
  status               PaymentStatus   @default(PENDING)
  receiptNumber        String?
  paidAt               DateTime?
  createdAt            DateTime        @default(now())
  order                Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Installment {
  id               String            @id @default(cuid())
  orderId          String
  payunitInvoiceId String?
  sequenceNumber   Int
  amount           Decimal           @db.Decimal(12, 2)
  dueDate          DateTime
  status           InstallmentStatus @default(PENDING)
  paidAt           DateTime?
  receiptNumber    String?
  createdAt        DateTime          @default(now())
  order            Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, status, dueDate])
}

model OrderStatusHistory {
  id            String      @id @default(cuid())
  orderId       String
  status        OrderStatus
  note          String?
  changedBy     String?
  createdAt     DateTime    @default(now())
  changedByUser User?       @relation("OrderStatusChangedBy", fields: [changedBy], references: [id])
  order         Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model AffiliateProfile {
  id               String              @id @default(cuid())
  userId           String              @unique
  status           AffiliateStatus     @default(PENDING)
  commissionRate   Decimal             @default(0.05) @db.Decimal(5, 4)
  payoutMethod     String              @default("MOBILE_MONEY")
  payoutPhone      String?
  payoutPreference PayoutPreference    @default(MONTHLY)
  totalEarned      Decimal             @default(0) @db.Decimal(12, 2)
  totalPaid        Decimal             @default(0) @db.Decimal(12, 2)
  websiteUrl       String?
  branchId         String?
  rejectionReason  String?
  rejectedAt       DateTime?
  suspensionReason String?
  suspendedAt      DateTime?
  revokedAt        DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  links            AffiliateLink[]
  branch           Branch?             @relation(fields: [branchId], references: [id])
  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  referrals        AffiliateReferral[]
  payouts          CommissionPayout[]
}

model AffiliateLink {
  id          String              @id @default(cuid())
  affiliateId String
  code        String              @unique
  targetUrl   String
  clickCount  Int                 @default(0)
  createdAt   DateTime            @default(now())
  affiliate   AffiliateProfile    @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  referrals   AffiliateReferral[]
}

model AffiliateReferral {
  id          String           @id @default(cuid())
  linkId      String
  affiliateId String
  orderId     String           @unique
  commission  Decimal          @db.Decimal(12, 2)
  status      ReferralStatus   @default(PENDING)
  createdAt   DateTime         @default(now())
  affiliate   AffiliateProfile @relation(fields: [affiliateId], references: [id])
  link        AffiliateLink    @relation(fields: [linkId], references: [id])
  order       Order            @relation(fields: [orderId], references: [id])

  @@index([orderId])
}

model CommissionPayout {
  id                    String           @id @default(cuid())
  affiliateId           String
  amount                Decimal          @db.Decimal(12, 2)
  currency              String           @default("XAF")
  payunitDisbursementId String?
  status                PayoutStatus     @default(PENDING)
  processedAt           DateTime?
  createdAt             DateTime         @default(now())
  affiliate             AffiliateProfile @relation(fields: [affiliateId], references: [id])
}

model BlogArticle {
  id            String        @id @default(cuid())
  slug          String        @unique
  title         String
  content       Json
  excerpt       String?
  coverImageUrl String?
  viewCount     Int           @default(0)
  authorId      String
  status        ArticleStatus @default(DRAFT)
  locale        String        @default("fr")
  publishedAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  /// Reviewer fields for approval workflow
  reviewedById  String?
  reviewedAt    DateTime?
  reviewerNote  String?
  /// Self-relation for draft versioning: when editing a published article,
  /// a new DRAFT row is created with draftOfId pointing to the original.
  draftOfId     String?
  author        User          @relation("AuthoredArticles", fields: [authorId], references: [id])
  draftOf       BlogArticle?  @relation("ArticleDrafts", fields: [draftOfId], references: [id])
  drafts        BlogArticle[] @relation("ArticleDrafts")
  reviewer      User?         @relation("ReviewedArticles", fields: [reviewedById], references: [id])
  tags          Tag[]         @relation("ArticleTags")

  @@index([status, publishedAt(sort: Desc)])
  @@index([draftOfId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType @default(SYSTEM)
  title     String
  body      String
  isRead    Boolean          @default(false)
  link      String?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt(sort: Desc)])
}

model ActivityLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String?
  entityId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id])

  @@index([userId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
}

model ServerCartItem {
  id        String         @id @default(cuid())
  userId    String
  variantId String
  quantity  Int
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([userId, variantId])
  @@index([userId])
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
}

model ProductStockByBranch {
  id                String         @id @default(cuid())
  variantId         String
  branchId          String
  stock             Int            @default(0)
  lowStockThreshold Int            @default(3)
  updatedAt         DateTime       @updatedAt
  branch            Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  variant           ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([variantId, branchId])
}

model CategoryVariantAxis {
  id        String                 @id @default(cuid())
  categoryId String
  name      String
  sortOrder Int                    @default(0)
  category  Category               @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  values    CategoryVariantAxisValue[]

  @@index([categoryId])
}

model CategoryVariantAxisValue {
  id        String                 @id @default(cuid())
  axisId    String
  value     String
  sortOrder Int                    @default(0)
  priceDelta Decimal?              @db.Decimal(10, 2) @default(0)
  axis      CategoryVariantAxis    @relation(fields: [axisId], references: [id], onDelete: Cascade)
  options   ProductVariantOption[]

  @@index([axisId])
}

model ProductVariantOption {
  id          String                @id @default(cuid())
  variantId   String
  axisValueId String
  axisValue   CategoryVariantAxisValue @relation(fields: [axisValueId], references: [id], onDelete: Cascade)
  variant     ProductVariant        @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([variantId, axisValueId])
  @@index([variantId])
  @@index([axisValueId])
}

model ProductReview {
  id              String       @id @default(cuid())
  productId       String
  userId          String
  /// 1–5
  rating          Int
  comment         String?
  status          ReviewStatus @default(PENDING)
  approvedBy      String?
  rejectionReason String?
  createdAt       DateTime     @default(now())
  approvedAt      DateTime?
  product         Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])
  @@index([productId, status])
}

model KnowledgeBaseDocument {
  id           String   @id @default(cuid())
  fileName     String
  fileUrl      String
  uploadedById String
  /// null = global
  branchId     String?
  /// PROCESSING | ACTIVE | FAILED
  status       String   @default("PROCESSING")
  errorMessage String?
  uploadedAt   DateTime @default(now())
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
}

model InStorePurchase {
  id              String   @id @default(cuid())
  receiptImageUrl String?
  /// null if customer is not a platform user
  purchaserId     String?
  affiliateId     String?
  productId       String?
  totalAmount     Decimal  @db.Decimal(12, 2)
  currency        String   @default("XAF")
  purchaseDate    DateTime
  /// [{ name, qty, unitPrice }]
  items           Json
  createdAt       DateTime @default(now())
  product         Product? @relation(fields: [productId], references: [id])
}

model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([isRead, createdAt(sort: Desc)])
}

model ProductPageView {
  id        String   @id @default(cuid())
  productId String
  branchId  String?
  sessionId String
  userId    String?
  createdAt DateTime @default(now())
  branch    Branch?  @relation(fields: [branchId], references: [id])
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id])

  @@index([productId, createdAt(sort: Desc)])
  @@index([branchId, createdAt(sort: Desc)])
  @@index([sessionId, productId])
}

model Broadcast {
  id             String   @id @default(cuid())
  senderId       String
  subject        String
  body           String
  targetAudience String
  branchId       String?
  recipientCount Int
  emailCopySent  Boolean  @default(false)
  createdAt      DateTime @default(now())
  sender         User     @relation("SentBroadcasts", fields: [senderId], references: [id])

  @@index([senderId, createdAt(sort: Desc)])
}

enum Role {
  CUSTOMER
  AFFILIATE
  STAFF
  ADMIN
  CENTRAL_ADMIN
}

enum Condition {
  NEW
  REFURBISHED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum DeliveryMethod {
  PICKUP
  DELIVERY
}

enum PaymentGateway {
  CM_MTNMOMO
  CM_ORANGE
}

enum PaymentMethod {
  MOBILE_MONEY
  CHECKOUT
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum InstallmentStatus {
  PENDING
  PAID
  OVERDUE
}

enum AffiliateStatus {
  PENDING
  APPROVED
  SUSPENDED
  REJECTED
  REVOKED
}

enum PayoutPreference {
  MONTHLY
  IMMEDIATE
}

enum ReferralStatus {
  PENDING
  CONFIRMED
  PAID
}

enum PayoutStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum ArticleStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  ARCHIVED
}

enum NotificationType {
  ORDER_UPDATE
  COMMISSION
  SYSTEM
  PROMOTION
  LOW_STOCK_ALERT
  AFFILIATE_APPLICATION
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum FulfillmentStatus {
  PENDING
  SHIPPED
  DELIVERED
}

enum FeatureFieldType {
  TEXT
  NUMBER
  DROPDOWN
}

enum CommissionType {
  PERCENTAGE
  FIXED
}
