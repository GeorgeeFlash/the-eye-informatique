generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  CUSTOMER
  AFFILIATE
  STAFF
  ADMIN
  CENTRAL_ADMIN
}

enum Condition {
  NEW
  REFURBISHED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum DeliveryMethod {
  PICKUP
  DELIVERY
}

enum PaymentGateway {
  CM_MTNMOMO
  CM_ORANGE
}

enum PaymentMethod {
  MOBILE_MONEY
  CHECKOUT
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum InstallmentStatus {
  PENDING
  PAID
  OVERDUE
}

enum AffiliateStatus {
  PENDING
  APPROVED
  SUSPENDED
  REJECTED
  REVOKED
}

enum PayoutPreference {
  MONTHLY
  IMMEDIATE
}

enum ReferralStatus {
  PENDING
  CONFIRMED
  PAID
}

enum PayoutStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum ArticleStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  ARCHIVED
}

enum NotificationType {
  ORDER_UPDATE
  COMMISSION
  SYSTEM
  PROMOTION
  LOW_STOCK_ALERT
  AFFILIATE_APPLICATION
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum FulfillmentStatus {
  PENDING
  SHIPPED
  DELIVERED
}

enum FeatureFieldType {
  TEXT
  NUMBER
  DROPDOWN
}

enum CommissionType {
  PERCENTAGE
  FIXED
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

model User {
  id              String   @id @default(cuid())
  clerkId         String   @unique
  email           String   @unique
  name            String?
  phone           String?
  role            Role     @default(CUSTOMER)
  preferredLocale String   @default("en")
  /// Non-null for STAFF and ADMIN; null for CENTRAL_ADMIN and CUSTOMER/AFFILIATE
  branchId        String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  branch             Branch?                 @relation(fields: [branchId], references: [id])
  addresses          Address[]
  orders             Order[]
  notifications      Notification[]
  affiliateProfile   AffiliateProfile?
  activityLogs       ActivityLog[]
  blogArticles       BlogArticle[]           @relation("AuthoredArticles")
  reviewedArticles   BlogArticle[]           @relation("ReviewedArticles")
  productReviews     ProductReview[]
  knowledgeBaseDocs  KnowledgeBaseDocument[]
  orderStatusChanges OrderStatusHistory[]    @relation("OrderStatusChangedBy")
  cartItems          ServerCartItem[]
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  label     String?
  street    String
  city      String
  region    String
  country   String   @default("CM")
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]
}

model Branch {
  id       String  @id @default(cuid())
  name     String
  city     String
  address  String
  phone    String?
  isActive Boolean @default(true)

  users                User[]
  orders               Order[]
  orderItemFulfillment OrderItem[]            @relation("OrderItemFulfillmentBranch")
  stockByBranch        ProductStockByBranch[]
  affiliates           AffiliateProfile[]
}

model Category {
  id        String  @id @default(cuid())
  slug      String  @unique
  name      String
  parentId  String?
  iconUrl   String?
  sortOrder Int     @default(0)

  parent        Category?              @relation("CategoryTree", fields: [parentId], references: [id])
  children      Category[]             @relation("CategoryTree")
  products      Product[]
  featureFields CategoryFeatureField[]
}

model Tag {
  id   String @id @default(cuid())
  name String @unique
  slug String @unique

  products     Product[]     @relation("ProductTags")
  blogArticles BlogArticle[] @relation("ArticleTags")
}

model Product {
  id              String          @id @default(cuid())
  slug            String          @unique
  name            String
  description     String?
  basePrice       Decimal         @db.Decimal(12, 2)
  currency        String          @default("XAF")
  categoryId      String
  brand           String?
  commissionType  CommissionType?
  commissionValue Decimal?        @db.Decimal(12, 2)
  metaTitle       String?
  metaDescription String?
  isActive        Boolean         @default(true)
  isFeatured      Boolean         @default(false)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  category         Category              @relation(fields: [categoryId], references: [id])
  images           ProductImage[]
  variants         ProductVariant[]
  tags             Tag[]                 @relation("ProductTags")
  reviews          ProductReview[]
  inStorePurchases InStorePurchase[]
  featureValues    ProductFeatureValue[]
}

model ProductVariant {
  id        String    @id @default(cuid())
  productId String
  sku       String    @unique
  color     String?
  condition Condition @default(NEW)
  stock     Int       @default(0)
  price     Decimal   @db.Decimal(12, 2)
  weight    Decimal?  @db.Decimal(8, 3)
  createdAt DateTime  @default(now())

  product       Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems    OrderItem[]
  stockByBranch ProductStockByBranch[]
  cartItems     ServerCartItem[]
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  alt       String?
  sortOrder Int     @default(0)
  isPrimary Boolean @default(false)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model CategoryFeatureField {
  id         String           @id @default(cuid())
  categoryId String
  name       String
  type       FeatureFieldType @default(TEXT)
  options    Json? /// For DROPDOWN: ["Option A", "Option B", ...]
  sortOrder  Int              @default(0)
  isRequired Boolean          @default(false)

  category      Category              @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  featureValues ProductFeatureValue[]

  @@index([categoryId])
}

model ProductFeatureValue {
  id             String @id @default(cuid())
  productId      String
  featureFieldId String
  value          String

  product      Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  featureField CategoryFeatureField @relation(fields: [featureFieldId], references: [id], onDelete: Cascade)

  @@unique([productId, featureFieldId])
  @@index([featureFieldId])
}

model Order {
  id                    String         @id @default(cuid())
  orderNumber           String         @unique
  userId                String
  status                OrderStatus    @default(PENDING)
  subtotal              Decimal        @db.Decimal(12, 2)
  tax                   Decimal        @default(0) @db.Decimal(12, 2)
  deliveryFee           Decimal        @default(0) @db.Decimal(12, 2)
  total                 Decimal        @db.Decimal(12, 2)
  currency              String         @default("XAF")
  deliveryMethod        DeliveryMethod @default(PICKUP)
  addressId             String?
  branchId              String?
  notes                 String?
  estimatedDeliveryDate DateTime?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  user          User                 @relation(fields: [userId], references: [id])
  address       Address?             @relation(fields: [addressId], references: [id])
  branch        Branch?              @relation(fields: [branchId], references: [id])
  items         OrderItem[]
  payment       Payment?
  installments  Installment[]
  referral      AffiliateReferral?
  statusHistory OrderStatusHistory[]

  @@index([userId, createdAt(sort: Desc)])
}

model OrderItem {
  id                  String            @id @default(cuid())
  orderId             String
  variantId           String
  quantity            Int
  unitPrice           Decimal           @db.Decimal(12, 2)
  total               Decimal           @db.Decimal(12, 2)
  fulfillmentBranchId String?
  fulfillmentStatus   FulfillmentStatus @default(PENDING)

  order             Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant           ProductVariant @relation(fields: [variantId], references: [id])
  fulfillmentBranch Branch?        @relation("OrderItemFulfillmentBranch", fields: [fulfillmentBranchId], references: [id])
}

model Payment {
  id                   String          @id @default(cuid())
  orderId              String          @unique
  payunitTransactionId String?
  gateway              PaymentGateway?
  method               PaymentMethod
  amount               Decimal         @db.Decimal(12, 2)
  currency             String          @default("XAF")
  status               PaymentStatus   @default(PENDING)
  receiptNumber        String?
  paidAt               DateTime?
  createdAt            DateTime        @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Installment {
  id               String            @id @default(cuid())
  orderId          String
  payunitInvoiceId String?
  sequenceNumber   Int
  amount           Decimal           @db.Decimal(12, 2)
  dueDate          DateTime
  status           InstallmentStatus @default(PENDING)
  paidAt           DateTime?
  createdAt        DateTime          @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, status, dueDate])
}

model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  status    OrderStatus
  note      String?
  changedBy String?
  createdAt DateTime    @default(now())

  order         Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedByUser User? @relation("OrderStatusChangedBy", fields: [changedBy], references: [id], onDelete: SetNull)
}

model AffiliateProfile {
  id               String           @id @default(cuid())
  userId           String           @unique
  status           AffiliateStatus  @default(PENDING)
  commissionRate   Decimal          @default(0.05) @db.Decimal(5, 4)
  payoutMethod     String           @default("MOBILE_MONEY")
  payoutPhone      String?
  payoutPreference PayoutPreference @default(MONTHLY)
  totalEarned      Decimal          @default(0) @db.Decimal(12, 2)
  totalPaid        Decimal          @default(0) @db.Decimal(12, 2)
  websiteUrl       String?
  branchId         String?
  rejectionReason  String?
  rejectedAt       DateTime?
  suspensionReason String?
  suspendedAt      DateTime?
  revokedAt        DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch    Branch?             @relation(fields: [branchId], references: [id])
  links     AffiliateLink[]
  referrals AffiliateReferral[]
  payouts   CommissionPayout[]
}

model AffiliateLink {
  id          String   @id @default(cuid())
  affiliateId String
  code        String   @unique
  targetUrl   String
  clickCount  Int      @default(0)
  createdAt   DateTime @default(now())

  affiliate AffiliateProfile    @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  referrals AffiliateReferral[]
}

model AffiliateReferral {
  id          String         @id @default(cuid())
  linkId      String
  affiliateId String
  orderId     String         @unique
  commission  Decimal        @db.Decimal(12, 2)
  status      ReferralStatus @default(PENDING)
  createdAt   DateTime       @default(now())

  link      AffiliateLink    @relation(fields: [linkId], references: [id])
  affiliate AffiliateProfile @relation(fields: [affiliateId], references: [id])
  order     Order            @relation(fields: [orderId], references: [id])

  @@index([orderId])
}

model CommissionPayout {
  id                    String       @id @default(cuid())
  affiliateId           String
  amount                Decimal      @db.Decimal(12, 2)
  currency              String       @default("XAF")
  payunitDisbursementId String?
  status                PayoutStatus @default(PENDING)
  processedAt           DateTime?
  createdAt             DateTime     @default(now())

  affiliate AffiliateProfile @relation(fields: [affiliateId], references: [id])
}

model BlogArticle {
  id            String        @id @default(cuid())
  slug          String        @unique
  title         String
  content       Json
  excerpt       String?
  coverImageUrl String?
  viewCount     Int           @default(0)
  authorId      String
  status        ArticleStatus @default(DRAFT)
  locale        String        @default("fr")
  publishedAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  /// Reviewer fields for approval workflow
  reviewedById String?
  reviewedAt   DateTime?
  reviewerNote String?

  /// Self-relation for draft versioning: when editing a published article,
  /// a new DRAFT row is created with draftOfId pointing to the original.
  draftOfId String?

  author   User          @relation("AuthoredArticles", fields: [authorId], references: [id])
  reviewer User?         @relation("ReviewedArticles", fields: [reviewedById], references: [id])
  draftOf  BlogArticle?  @relation("ArticleDrafts", fields: [draftOfId], references: [id])
  drafts   BlogArticle[] @relation("ArticleDrafts")
  tags     Tag[]         @relation("ArticleTags")

  @@index([status, publishedAt(sort: Desc)])
  @@index([draftOfId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType @default(SYSTEM)
  title     String
  body      String
  isRead    Boolean          @default(false)
  link      String?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt(sort: Desc)])
}

model ActivityLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String?
  entityId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
}

model ServerCartItem {
  id        String   @id @default(cuid())
  userId    String
  variantId String
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([userId, variantId])
  @@index([userId])
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// New models (SRS Phase 1 additions)
// ---------------------------------------------------------------------------

model ProductStockByBranch {
  id                String   @id @default(cuid())
  variantId         String
  branchId          String
  stock             Int      @default(0)
  lowStockThreshold Int      @default(3)
  updatedAt         DateTime @updatedAt

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  branch  Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([variantId, branchId])
}

model ProductReview {
  id              String       @id @default(cuid())
  productId       String
  userId          String
  rating          Int /// 1–5
  comment         String?
  status          ReviewStatus @default(PENDING)
  approvedBy      String?
  rejectionReason String?
  createdAt       DateTime     @default(now())
  approvedAt      DateTime?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])
  @@index([productId, status])
}

model KnowledgeBaseDocument {
  id           String   @id @default(cuid())
  fileName     String
  fileUrl      String
  uploadedById String
  branchId     String? /// null = global
  /// PROCESSING | ACTIVE | FAILED
  status       String   @default("PROCESSING")
  errorMessage String?
  uploadedAt   DateTime @default(now())

  uploadedBy User @relation(fields: [uploadedById], references: [id])
}

model InStorePurchase {
  id              String   @id @default(cuid())
  receiptImageUrl String?
  purchaserId     String? /// null if customer is not a platform user
  affiliateId     String?
  productId       String?
  totalAmount     Decimal  @db.Decimal(12, 2)
  currency        String   @default("XAF")
  purchaseDate    DateTime
  items           Json /// [{ name, qty, unitPrice }]
  createdAt       DateTime @default(now())

  product Product? @relation(fields: [productId], references: [id])
}

model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([isRead, createdAt(sort: Desc)])
}
